# Stromer-Datensammler. Kopieren nach .env und Werte anpassen.

# Datenbank und Stromer-Token, auf dem RAID. Ordner muss uid 1000 (pi) gehoeren.
DATA_LOCATION=/mnt/raid/docker/stromer/data

# Port im Heimnetz (Fritz!Box leitet ihn NICHT weiter)
PORT=8095

# Abfrage-Intervalle
POLL_STATE_MINUTES=5
POLL_SETTINGS_MINUTES=30
POLL_STATISTICS_HOURS=6
